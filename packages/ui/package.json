{
  "name": "@dev-in-realtime/ui",
  "version": "0.0.0",
  "description": "React component library (shadcn/ui + Radix primitives) styled via a Tailwind preset.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-in-realtime/design-system.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "tailwind-preset.cjs"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@dev-in-realtime/tokens": "workspace:*",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.14",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
